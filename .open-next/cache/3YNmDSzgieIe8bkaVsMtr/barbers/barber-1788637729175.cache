;q=75 48w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=64&amp;q=75 64w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=96&amp;q=75 96w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=128&amp;q=75 128w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fmasters%2F1788624733100f.png&amp;w=3840&amp;q=75\"/></div></div><div class=\"md:col-span-2 flex flex-col justify-center\"><h1 class=\"text-4xl md:text-5xl font-bold mb-2\">Максим</h1><p class=\"text-xl text-blue-400 mb-4\">Барбер</p><div class=\"flex items-center gap-2 mb-4\"><div class=\"flex text-yellow-400 text-lg\"><span>★</span><span>★</span><span>★</span><span>★</span><span>★</span></div><span class=\"text-gray-400 text-sm\">5.0<!-- --> (285 отзывов)</span></div><p class=\"text-gray-300 leading-relaxed text-lg whitespace-pre-line\">Дружелюбный специалист. Ответственный, аккуратный, делает укладки и стрижки максимально бережно. </p></div></div><section class=\"mb-12\"><h2 class=\"text-2xl md:text-3xl font-bold mb-6 border-l-4 border-blue-600 pl-4\">Услуги и цены</h2><div class=\"grid md:grid-cols-2 gap-4\"><div class=\"bg-gray-800 p-5 rounded-xl border border-gray-700\"><div class=\"flex justify-between items-start gap-4 mb-2\"><h3 class=\"text-lg font-semibold text-white\">Стрижка головы</h3><div class=\"text-xl font-bold text-blue-400 whitespace-nowrap\">40 BYN</div></div><p class=\"text-gray-400 text-sm mb-1\">1 ч</p><p class=\"text-gray-500 text-xs mt-2\">Профессиональная стрижка с учетом ваших предпочтений и анатомических особенностей.</p></div><div class=\"bg-gray-800 p-5 rounded-xl border border-gray-700\"><div class=\"flex justify-between items-start gap-4 mb-2\"><h3 class=\"text-lg font-semibold text-white\">Удлинённая стрижка</h3><div class=\"text-xl font-bold text-blue-400 whitespace-nowrap\">40 BYN</div></div><p class=\"text-gray-400 text-sm mb-1\">1 ч</p><p class=\"text-gray-500 text-xs mt-2\">Удлинённые дизайны стрижек, актуальная длина волос по всей окружности головы от 10 см.</p></div><div class=\"bg-gray-800 p-5 rounded-xl border border-gray-700\"><div class=\"flex justify-between items-start gap-4 mb-2\"><h3 class=\"text-lg font-semibold text-white\">Стрижка машинкой</h3><div class=\"text-xl font-bold text-blue-400 whitespace-nowrap\">35 BYN</div></div><p class=\"text-gray-400 text-sm mb-1\">1 ч</p><p class=\"text-gray-500 text-xs mt-2\">Стрижка машинкой — идеально подходит для свежего и уходового образа.</p></div><div class=\"bg-gray-800 p-5 rounded-xl border border-gray-700\"><div class=\"flex justify-between items-start gap-4 mb-2\"><h3 class=\"text-lg font-semibold text-white\">Стрижка комплекс (голова + борода)</h3><div class=\"text-xl font-bold text-blue-400 whitespace-nowrap\">55 BYN</div></div><p class=\"text-gray-400 text-sm mb-1\">2 ч</p><p class=\"text-gray-500 text-xs mt-2\">Совместная стрижка головы и оформления бороды — гармоничный и ухоженный образ.</p></div><div class=\"bg-gray-800 p-5 rounded-xl border border-gray-700\"><div class=\"flex justify-between items-start gap-4 mb-2\"><h3 class=\"text-lg font-semibold text-white\">Детская стрижка (5-12 лет)</h3><div class=\"text-xl font-bold text-blue-400 whitespace-nowrap\">35 BYN</div></div><p class=\"text-gray-400 text-sm mb-1\">1 ч</p><p class=\"text-gray-500 text-xs mt-2\">Компетентное и бережное обслуживание для маленьких клиентов.</p></div><div class=\"bg-gray-800 p-5 rounded-xl border border-gray-700\"><div class=\"flex justify-between items-start gap-4 mb-2\"><h3 class=\"text-lg font-semibold text-white\">Стрижка папа+сын (5-12 лет)</h3><div class=\"text-xl font-bold text-blue-400 whitespace-nowrap\">70 BYN</div></div><p class=\"text-gray-400 text-sm mb-1\">2 ч</p><p class=\"text-gray-500 text-xs mt-2\">Совместная стрижка для семьи — стильное решение, объединяющее папу и ребенка.</p></div><div class=\"bg-gray-800 p-5 rounded-xl border border-gray-700\"><div class=\"flex justify-between items-start gap-4 mb-2\"><h3 class=\"text-lg font-semibold text-white\">Стрижка бро+бро</h3><div class=\"text-xl font-bold text-blue-400 whitespace-nowrap\">75 BYN</div></div><p class=\"text-gray-400 text-sm mb-1\">2 ч</p><p class=\"text-gray-500 text-xs mt-2\">Мужская стрижка для друзей или коллег. Стильное решение для тех, кто ценит ухоженный вид.</p></div><div class=\"bg-gray-800 p-5 rounded-xl border border-gray-700\"><div class=\"flex justify-between items-start gap-4 mb-2\"><h3 class=\"text-lg font-semibold text-white\">Стрижка бороды</h3><div class=\"text-xl font-bold text-blue-400 whitespace-nowrap\">30 BYN</div></div><p class=\"text-gray-400 text-sm mb-1\">1 ч</p><p class=\"text-gray-500 text-xs mt-2\">Формирование и моделирование бороды и усов: аккуратные линии, четкий контур.</p></div></div></section><section class=\"mb-12\"><h2 class=\"text-2xl md:text-3xl font-bold mb-6 border-l-4 border-blue-600 pl-4\">Портфолио работ</h2><div class=\"grid grid-cols-2 md:grid-cols-3 gap-4\"><div class=\"relative aspect-square rounded-xl overflow-hidden border border-gray-800 bg-gray-800\"><img alt=\"1\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 50vw, 33vw\" srcSet=\"/_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fportfolio%2F1788643730.png&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fportfolio%2F1788643730.png&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fportfolio%2F1788643730.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.jsdelivr.net%2Fgh%2Fakane-coder%2Fbarbershop-images%40main%2Fpublic%2Fimages%2Fportfolio%2F1788643730.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%