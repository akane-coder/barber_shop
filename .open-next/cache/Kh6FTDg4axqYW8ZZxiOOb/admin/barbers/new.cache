{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/admin/layout,_N_T_/admin/barbers/layout,_N_T_/admin/barbers/new/layout,_N_T_/admin/barbers/new/page,_N_T_/admin/barbers/new"}},"html":"<!DOCTYPE html><!--Kh6FTDg4axqYW8ZZxiOOb--><html lang=\"ru\" class=\"__variable_246ccd __variable_c29908 h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/e52868faaa7051ba.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-87a4096ed2b4d747.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-37e0f0325134c4d7.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-290572149fe5c423.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-7e1074c669cfdf00.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/admin/barbers/new/page-a5c7beb02e29c29a.js\" async=\"\"></script><title>Дядюшка Ру | Барбершоп в Бобруйске</title><meta name=\"description\" content=\"Профессиональные стрижки и бритьё в Бобруйске. Запись онлайн к лучшим мастерам.\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"min-h-screen bg-gray-900 p-8\"><div class=\"max-w-4xl mx-auto\"><button class=\"text-gray-400 hover:text-white mb-4 flex items-center gap-2\">← Назад к списку</button><form class=\"bg-gray-800 p-6 rounded-lg shadow-lg max-w-4xl mx-auto text-white space-y-6\"><h2 class=\"text-2xl font-bold mb-6\">Новый мастер</h2><div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"><div><label class=\"block text-sm mb-1 text-gray-400\">Имя и Фамилия *</label><input type=\"text\" required=\"\" class=\"w-full p-2 rounded bg-gray-700 border border-gray-600 focus:border-blue-500 outline-none\" placeholder=\"Например: Иван Петров\" value=\"\"/></div><div><label class=\"block text-sm mb-1 text-gray-400\">Должность</label><select class=\"w-full p-2 rounded bg-gray-700 border border-gray-600 focus:border-blue-500 outline-none\"><option selected=\"\">Барбер</option><option>Старший барбер</option><option>Топ-барбер</option></select></div></div><div><label class=\"block text-sm mb-1 text-blue-400 font-semibold\">YClients Staff ID *</label><div class=\"flex gap-2\"><input type=\"number\" required=\"\" class=\"flex-1 p-2 rounded bg-gray-700 border border-gray-600 focus:border-blue-500 outline-none\" placeholder=\"Например: 5772390\" value=\"\"/><button type=\"button\" disabled=\"\" class=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded text-sm font-medium disabled:opacity-50 transition\">Синхронизировать</button></div><p class=\"text-xs text-gray-500 mt-1\">ID мастера из системы YClients. Нажмите &quot;Синхронизировать&quot; чтобы проверить статус загрузки.</p></div><div><label class=\"block text-sm mb-1 text-gray-400\">Ссылка на фото (jsDelivr / GitHub)</label><input type=\"url\" class=\"w-full p-2 rounded bg-gray-700 border border-gray-600 focus:border-blue-500 outline-none\" placeholder=\"https://cdn.jsdelivr.net/gh/username/repo@main/public/images/masters/photo.jpg\" value=\"\"/></div><div><label class=\"block text-sm mb-1 text-gray-400\">О мастере (Био)</label><textarea rows=\"3\" class=\"w-full p-2 rounded bg-gray-700 border border-gray-600 focus:border-blue-500 outline-none\" placeholder=\"Например: Барбер, специализирующийся на коротких мужских стрижках и моделировании бороды. Опытный мастер, который ценит перфекционизм в работе и абсолютный комфорт клиента.\"></textarea></div><div><label class=\"block text-sm mb-1 text-gray-400\">Специализации (теги)</label><div class=\"flex gap-2 mb-2\"><input type=\"text\" class=\"flex-1 p-2 rounded bg-gray-700 border border-gray-600 focus:border-blue-500 outline-none\" placeholder=\"Например: Фейды\" value=\"\"/><button type=\"button\" class=\"px-4 py-2 bg-gray-600 hover:bg-gray-500 rounded\">+</button></div><div class=\"flex flex-wrap gap-2\"></div></div><div><label class=\"block text-sm mb-1 text-gray-400\">Услуги, которые выполняет</label><div class=\"flex gap-2 mb-2\"><input type=\"text\" class=\"flex-1 p-2 rounded bg-gray-700 border border-gray-600 focus:border-blue-500 outline-none\" placeholder=\"Например: Мужская стрижка\" value=\"\"/><button type=\"button\" class=\"px-4 py-2 bg-gray-600 hover:bg-gray-500 rounded\">+</button></div><div class=\"flex flex-wrap gap-2\"></div></div><div><label class=\"block text-sm mb-1 text-gray-400\">Портфолио (до 7 работ)</label><div class=\"space-y-2 mb-2\"><input type=\"url\" class=\"w-full p-2 rounded bg-gray-700 border border-gray-600 focus:border-blue-500 outline-none\" placeholder=\"https://cdn.jsdelivr.net/gh/...\" value=\"\"/><div class=\"flex gap-2\"><input type=\"text\" class=\"flex-1 p-2 rounded bg-gray-700 border border-gray-600 focus:border-blue-500 outline-none\" placeholder=\"Название работы (например: Классический фейд)\" value=\"\"/><button type=\"button\" class=\"px-4 py-2 bg-gray-600 hover:bg-gray-500 rounded\">Добавить фото</button></div></div><div class=\"grid grid-cols-2 md:grid-cols-4 gap-2\"></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"><div><label class=\"block text-sm mb-1 text-gray-400\">Рейтинг (0-5)</label><input type=\"number\" step=\"0.1\" min=\"0\" max=\"5\" class=\"w-full p-2 rounded bg-gray-700 border border-gray-600 focus:border-blue-500 outline-none\" value=\"0\"/></div><div><label class=\"block text-sm mb-1 text-gray-400\">Количество отзывов</label><input type=\"number\" min=\"0\" class=\"w-full p-2 rounded bg-gray-700 border border-gray-600 focus:border-blue-500 outline-none\" value=\"0\"/></div></div><div class=\"flex items-center gap-6\"><label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"checkbox\" class=\"w-4 h-4 rounded bg-gray-700 border-gray-600\" checked=\"\"/><span class=\"text-sm\">Активен (отображается на сайте)</span></label><label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"checkbox\" class=\"w-4 h-4 rounded bg-gray-700 border-gray-600\"/><span class=\"text-sm\">Показывать первым (Топ)</span></label></div><div class=\"flex gap-4 pt-4 border-t border-gray-700\"><button type=\"submit\" class=\"flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded transition disabled:opacity-50\">Сохранить мастера</button><button type=\"button\" class=\"px-6 py-3 bg-gray-700 hover:bg-gray-600 rounded transition\">Отмена</button></div></form></div></div><!--$--><!--/$--><noscript><div><img src=\"https://mc.yandex.ru/watch/12345678\" style=\"position:absolute;left:-9999px\" alt=\"\"/></div></noscript><script src=\"/_next/static/chunks/webpack-87a4096ed2b4d747.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[9766,[],\\\"\\\"]\\n3:I[8924,[],\\\"\\\"]\\n4:I[1402,[\\\"177\\\",\\\"static/chunks/app/layout-7e1074c669cfdf00.js\\\"],\\\"\\\"]\\n5:I[1959,[],\\\"ClientPageRoot\\\"]\\n6:I[2766,[\\\"567\\\",\\\"static/chunks/app/admin/barbers/new/page-a5c7beb02e29c29a.js\\\"],\\\"default\\\"]\\n9:I[4431,[],\\\"OutletBoundary\\\"]\\nb:I[5278,[],\\\"AsyncMetadataOutlet\\\"]\\nd:I[4431,[],\\\"ViewportBoundary\\\"]\\nf:I[4431,[],\\\"MetadataBoundary\\\"]\\n10:\\\"$Sreact.suspense\\\"\\n12:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/css/e52868faaa7051ba.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"Kh6FTDg4axqYW8ZZxiOOb\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"admin\\\",\\\"barbers\\\",\\\"new\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"admin\\\",{\